[node name="ReadableComponent" parent="DEMO_HINTS/Hint_10_Sittable_Physics" index="6" unique_id=1768800036]
readable_title = "Sittables - Physics Sittable"
readable_content = "These chairs are examples of a [b]Physics Sittable[/b]. 

It keeps the player on the Sit Marker & dynamically adjusts the view angle to follow the Look Marker.

[b]Exit Behaviour[/b]

On exit the player can be placed using these behaviours:

Original: Places player at pre-sitting position

Transform : Places player at a 'Leave Marker'.

Displacement: Places player at pre-sitting displacement

Auto: Places the player in a free spot using the Navmesh.
"
rich_text = true

